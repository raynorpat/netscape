include_guard(GLOBAL)
set(NETSCAPE_JAVA_ROOT "" CACHE PATH "Legacy dist directory containing lib/ Java archives and include/ headers")
if(NOT IS_DIRECTORY "${NETSCAPE_JAVA_ROOT}/lib")
 message(FATAL_ERROR "Set NETSCAPE_JAVA_ROOT to a compatible legacy Java distribution with lib/ archives")
endif()
set(NETSCAPE_JAVA_LIBRARIES)
foreach(name nsn njs nsa javai javart sunmd awt mmedia)
  find_library(NETSCAPE_JAVA_${name} NAMES ${name} lib${name} PATHS "${NETSCAPE_JAVA_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
  add_library(netscape_java_${name} STATIC IMPORTED GLOBAL)
  set_target_properties(netscape_java_${name} PROPERTIES IMPORTED_LOCATION "${NETSCAPE_JAVA_${name}}")
  list(APPEND NETSCAPE_JAVA_LIBRARIES netscape_java_${name})
endforeach()
target_include_directories(netscape_platform INTERFACE "${NETSCAPE_JAVA_ROOT}/include")
