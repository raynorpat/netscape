include_guard(GLOBAL)
include(GNUInstallDirs)
file(STRINGS "${PROJECT_SOURCE_DIR}/cmd/xfe/versionn.h" version_line REGEX "^#define VERSION_NUMBER")
string(REGEX REPLACE "^#define VERSION_NUMBER[ \t]+" "" NETSCAPE_VERSION "${version_line}")
set(NETSCAPE_DATA_DIR "${CMAKE_INSTALL_DATADIR}/netscape")
set(NETSCAPE_PRIVATE_DIR "${CMAKE_INSTALL_LIBEXECDIR}/netscape")
set(NETSCAPE_JAVA_DIR "${CMAKE_INSTALL_LIBDIR}/netscape")
set(NETSCAPE_DOC_DIR "${CMAKE_INSTALL_DATAROOTDIR}/doc/netscape")
file(RELATIVE_PATH NETSCAPE_PRIVATE_FROM_BIN "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}" "${CMAKE_INSTALL_PREFIX}/${NETSCAPE_PRIVATE_DIR}")
file(RELATIVE_PATH NETSCAPE_DATA_FROM_BIN "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}" "${CMAKE_INSTALL_PREFIX}/${NETSCAPE_DATA_DIR}")
file(RELATIVE_PATH NETSCAPE_JAVA_FROM_BIN "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}" "${CMAKE_INSTALL_PREFIX}/${NETSCAPE_JAVA_DIR}")
set(NETSCAPE_JAVA_ARCHIVE_NAME "java_${NETSCAPE_VERSION}")
function(netscape_install_launcher name mode)
 set(NETSCAPE_LAUNCH_MODE "${mode}")
 set(output "${PROJECT_BINARY_DIR}/install-scripts/${name}")
 configure_file("${PROJECT_SOURCE_DIR}/cmake/templates/launcher.sh.in" "${output}" @ONLY NEWLINE_STYLE UNIX)
 install(PROGRAMS "${output}" DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Runtime)
endfunction()
if(TARGET netscape-export)
 install(TARGETS netscape-export RUNTIME DESTINATION "${NETSCAPE_PRIVATE_DIR}" COMPONENT Runtime)
 netscape_install_launcher(netscape browser)
 netscape_install_launcher(netscape-export browser)
 install(FILES "${NETSCAPE_GENERATED}/xfe/RESOURCES-export.ad" DESTINATION "${NETSCAPE_DATA_DIR}" RENAME Netscape.ad COMPONENT Runtime)
 install(FILES "${PROJECT_SOURCE_DIR}/cmd/xfe/XKeysymDB" DESTINATION "${NETSCAPE_DATA_DIR}" COMPONENT Runtime)
 install(DIRECTORY "${NETSCAPE_LOCALIZED_DIR}/" DESTINATION "${NETSCAPE_DATA_DIR}" COMPONENT Runtime FILES_MATCHING PATTERN "*.html" PATTERN "*.msg")
 install(FILES "${PROJECT_SOURCE_DIR}/cmake/templates/netscape.desktop" DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/applications" COMPONENT Runtime)
 install(FILES "${PROJECT_SOURCE_DIR}/l10n/us/xp/LICENSE-export" DESTINATION "${NETSCAPE_DOC_DIR}" RENAME LICENSE COMPONENT Runtime)
endif()
if(TARGET netscape_java_vm)
 install(TARGETS netscape_java_vm netscape_javah netscape_javap RUNTIME DESTINATION "${NETSCAPE_PRIVATE_DIR}" COMPONENT Runtime)
 netscape_install_launcher(netscape-java java)
 netscape_install_launcher(netscape-javah javah)
 netscape_install_launcher(netscape-javap javap)
 install(FILES "${java_class_archive}" DESTINATION "${NETSCAPE_JAVA_DIR}" COMPONENT Runtime)
 set(NETSCAPE_JAVA_COMPILER_ARCHIVE "" CACHE FILEPATH "Optional compatible javac.zip to install with compiler launchers")
 if(NETSCAPE_REBUILD_JAVA_CLASSES)
  set(compiler_archive "${SUN_JAVA_STAGE}/classes/javac.zip")
 elseif(NETSCAPE_JAVA_COMPILER_ARCHIVE)
  if(NOT EXISTS "${NETSCAPE_JAVA_COMPILER_ARCHIVE}")
   message(FATAL_ERROR "NETSCAPE_JAVA_COMPILER_ARCHIVE does not exist")
  endif()
  set(compiler_archive "${NETSCAPE_JAVA_COMPILER_ARCHIVE}")
 endif()
 if(compiler_archive)
  install(FILES "${compiler_archive}" DESTINATION "${NETSCAPE_JAVA_DIR}" RENAME javac.zip COMPONENT Runtime)
  netscape_install_launcher(netscape-javac javac)
  netscape_install_launcher(netscape-javadoc javadoc)
 endif()
elseif(NETSCAPE_ENABLE_JAVA)
 set(NETSCAPE_JAVA_RUNTIME_ARCHIVE "${PROJECT_SOURCE_DIR}/sun-java/classsrc/${NETSCAPE_JAVA_ARCHIVE_NAME}.x" CACHE FILEPATH "Class archive matching imported Java runtime archives")
 install(FILES "${NETSCAPE_JAVA_RUNTIME_ARCHIVE}" DESTINATION "${NETSCAPE_JAVA_DIR}" RENAME "${NETSCAPE_JAVA_ARCHIVE_NAME}" COMPONENT Runtime)
endif()
if(TARGET netscape_mocha_shell)
 install(TARGETS netscape_mocha_shell RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Runtime)
endif()
if(NETSCAPE_ENABLE_SECURITY)
 set(NETSCAPE_POLICY_VARIANT export CACHE STRING "Bundled legacy signed policy variant")
 set_property(CACHE NETSCAPE_POLICY_VARIANT PROPERTY STRINGS export us france)
 if(NOT NETSCAPE_POLICY_VARIANT MATCHES "^(export|us|france)$")
  message(FATAL_ERROR "NETSCAPE_POLICY_VARIANT must be export, us or france")
 endif()
 install(FILES "${PROJECT_SOURCE_DIR}/security/policy/en-${NETSCAPE_POLICY_VARIANT}.zip" DESTINATION "${NETSCAPE_DATA_DIR}" RENAME policyMoz40P2 COMPONENT Runtime)
 file(GLOB policies CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/security/policy/*-${NETSCAPE_POLICY_VARIANT}.zip")
 foreach(policy IN LISTS policies)
  get_filename_component(name "${policy}" NAME)
  string(REGEX REPLACE "-${NETSCAPE_POLICY_VARIANT}.zip$" "" language "${name}")
  install(FILES "${policy}" DESTINATION "${NETSCAPE_DATA_DIR}/${language}" RENAME policyMoz40P2 COMPONENT Runtime)
 endforeach()
endif()
install(FILES "${PROJECT_SOURCE_DIR}/README.md" "${PROJECT_SOURCE_DIR}/README.jwz" DESTINATION "${NETSCAPE_DOC_DIR}" COMPONENT Runtime)
install(FILES "${PROJECT_SOURCE_DIR}/cmake/README.md" DESTINATION "${NETSCAPE_DOC_DIR}" RENAME CMake.md COMPONENT Runtime)
install(FILES "${PROJECT_SOURCE_DIR}/cmake/sun-java.md" DESTINATION "${NETSCAPE_DOC_DIR}" COMPONENT Runtime)
install(FILES "${PROJECT_SOURCE_DIR}/jpeg/README" DESTINATION "${NETSCAPE_DOC_DIR}/licenses" RENAME IJG-README COMPONENT Runtime)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/l10n/us/xp/" DESTINATION "${NETSCAPE_DOC_DIR}/licenses" COMPONENT Runtime FILES_MATCHING PATTERN "LICENSE-*")
set(development_default OFF)
if(NOT TARGET netscape-export AND NOT TARGET netscape_java_vm)
 set(development_default ON)
endif()
option(NETSCAPE_INSTALL_DEVELOPMENT "Install built static archives and legacy headers" ${development_default})
if(NETSCAPE_INSTALL_DEVELOPMENT)
 get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
 foreach(target IN LISTS targets)
  get_target_property(type "${target}" TYPE)
  get_target_property(excluded "${target}" EXCLUDE_FROM_ALL)
  if(type STREQUAL "STATIC_LIBRARY" AND NOT excluded)
   install(TARGETS ${target} ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}/netscape" COMPONENT Development)
  endif()
 endforeach()
 install(DIRECTORY "${PROJECT_SOURCE_DIR}/include/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/netscape" COMPONENT Development FILES_MATCHING PATTERN "*.h")
 if(TARGET netscape_security_resources)
  install(FILES "${NETSCAPE_GENERATED}/include/allxpstr.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/netscape" COMPONENT Development)
 endif()
 install(DIRECTORY "${PROJECT_SOURCE_DIR}/nspr/include/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/netscape/nspr" COMPONENT Development FILES_MATCHING PATTERN "*.h" PATTERN "*.OBJ" EXCLUDE)
 install(FILES "${NSPR_GENERATED_INCLUDE}/prcpucfg.h" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/netscape/nspr" COMPONENT Development)
 install(DIRECTORY "${PROJECT_SOURCE_DIR}/jpeg/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/netscape/jpeg" COMPONENT Development FILES_MATCHING PATTERN "*.h")
endif()
