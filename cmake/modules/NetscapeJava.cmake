include_guard(GLOBAL)
set(NETSCAPE_JAVA_PROVIDER SOURCE CACHE STRING "Java runtime provider: SOURCE or IMPORTED")
set_property(CACHE NETSCAPE_JAVA_PROVIDER PROPERTY STRINGS SOURCE IMPORTED)
if(NETSCAPE_JAVA_PROVIDER STREQUAL "IMPORTED")
 if(NETSCAPE_BUILD_SUN_JAVA)
  message(FATAL_ERROR "NETSCAPE_BUILD_SUN_JAVA requires the SOURCE provider")
 endif()
 include(NetscapeImportedJava)
elseif(NETSCAPE_JAVA_PROVIDER STREQUAL "SOURCE")
 include("${PROJECT_SOURCE_DIR}/cmake/targets/sun-java.cmake")
else()
 message(FATAL_ERROR "NETSCAPE_JAVA_PROVIDER must be SOURCE or IMPORTED")
endif()
