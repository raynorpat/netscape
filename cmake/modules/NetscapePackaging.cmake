include_guard(GLOBAL)
set(CPACK_PACKAGE_NAME netscape-legacy)
set(CPACK_PACKAGE_VENDOR "Legacy Netscape source build")
set(CPACK_PACKAGE_CONTACT "Local build" CACHE STRING "Package maintainer contact")
set(CPACK_PACKAGE_VERSION "${NETSCAPE_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Netscape browser, mail and news client")
set(CPACK_PACKAGE_DESCRIPTION_FILE "${PROJECT_SOURCE_DIR}/README.md")
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${NETSCAPE_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_GENERATOR TGZ CACHE STRING "Binary package generators: TGZ, DEB and/or RPM")
set(CPACK_PACKAGE_RELOCATABLE TRUE)
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_DEBIAN_PACKAGE_SECTION web)
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_CONTACT}")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON CACHE BOOL "Discover Debian runtime shared-library dependencies")
set(CPACK_RPM_PACKAGE_LICENSE "See bundled original notices")
set(CPACK_RPM_PACKAGE_AUTOREQ ON)
set(CPACK_SOURCE_GENERATOR TGZ)
set(CPACK_SOURCE_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${NETSCAPE_VERSION}-source")
set(CPACK_SOURCE_IGNORE_FILES "/[.]git/;/out/;/[.]cmake[^/]*/;/[^/]*[.]OBJ/;/dist/;[.]pyc$;/__pycache__/;[.]tar[.]gz$;~$")
include(CPack)
