include_guard(GLOBAL)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "The migrated XFE/NSPR platform is Linux. Use NETSCAPE_BUILD_BROWSER=OFF and NETSCAPE_BUILD_LEGACY=OFF for portable libraries.")
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86|x86_64|amd64|aarch64|arm64)$")
  message(FATAL_ERROR "NSPR Linux supports x86, x86_64 and AArch64")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_program(NETSCAPE_SH sh REQUIRED)
add_library(netscape_platform INTERFACE)
target_compile_definitions(netscape_platform INTERFACE XP_UNIX MOZILLA_CLIENT NSPR AKBAR LINUX LINUX1_2 SW_THREADS HAVE_STRERROR _DEFAULT_SOURCE DEBUG_jwz NEW_DECODERS
  $<$<CONFIG:Debug>:DEBUG> $<$<NOT:$<CONFIG:Debug>>:NDEBUG>)
if(NETSCAPE_ENABLE_MOCHA)
  target_compile_definitions(netscape_platform INTERFACE MOCHA)
endif()
if(NETSCAPE_ENABLE_JAVA)
  target_compile_definitions(netscape_platform INTERFACE JAVA)
endif()
# Reproduce exported header namespaces without writing into the source tree.
set(NETSCAPE_GENERATED "${PROJECT_BINARY_DIR}/generated")
file(GLOB nspr_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/nspr/include/*.h")
foreach(header IN LISTS nspr_headers)
  get_filename_component(name "${header}" NAME)
  configure_file("${header}" "${NETSCAPE_GENERATED}/nspr/${name}" COPYONLY)
endforeach()
file(GLOB mocha_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/mocha/include/*.h")
foreach(header IN LISTS mocha_headers)
  get_filename_component(name "${header}" NAME)
  configure_file("${header}" "${NETSCAPE_GENERATED}/mocha/${name}" COPYONLY)
endforeach()
set(include_dirs include nspr/include nspr/include/os mocha/include jpeg lib/layout lib/libparse lib/libnet lib/libmsg lib/libimg lib/libmime lib/libmisc lib/libjava lib/plugin lib/xp lib/libdbm lib/libjar cmd/xfe cmd/xfe/Microline sun-java/include sun-java/md-include sun-java/include/_gen sun-java/netscape/applet/_gen sun-java/netscape/javascript/_gen)
foreach(directory IN LISTS include_dirs)
  target_include_directories(netscape_platform INTERFACE "${PROJECT_SOURCE_DIR}/${directory}")
endforeach()
foreach(directory cert crypto hash key nav pkcs11 pkcs12 pkcs7 ssl util)
  target_include_directories(netscape_platform INTERFACE "${PROJECT_SOURCE_DIR}/security/lib/${directory}")
endforeach()
target_include_directories(netscape_platform BEFORE INTERFACE "${NETSCAPE_GENERATED}" "${NSPR_GENERATED_INCLUDE}" "${NETSCAPE_GENERATED}/net" "${NETSCAPE_GENERATED}/xfe")

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
 target_compile_definitions(netscape_platform INTERFACE IS_64)
endif()
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
 target_compile_options(netscape_platform INTERFACE -fcommon -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion)
endif()

find_package(X11 REQUIRED COMPONENTS Xt Xmu Xpm Xext SM ICE)
find_package(Motif REQUIRED)
target_include_directories(netscape_platform INTERFACE ${X11_INCLUDE_DIR} ${MOTIF_INCLUDE_DIR})

if(NETSCAPE_ENABLE_SECURITY)
 target_compile_definitions(netscape_platform INTERFACE HAVE_SECURITY)
else()
 target_compile_definitions(netscape_platform INTERFACE NO_SSL)
endif()
