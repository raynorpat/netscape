include_guard(GLOBAL)
function(netscape_archive target directory output)
  set(sources)
  foreach(source IN LISTS ARGN)
    list(APPEND sources "${PROJECT_SOURCE_DIR}/${directory}/${source}")
  endforeach()
  add_library(${target} STATIC ${sources})
  set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output}" C_STANDARD 90 C_EXTENSIONS ON)
  target_link_libraries(${target} PRIVATE netscape_platform)
  target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/${directory}")
  add_dependencies(${target} netscape_nspr_headers)
endfunction()
