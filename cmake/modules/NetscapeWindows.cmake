include_guard(GLOBAL)
if(NOT MSVC)
 message(FATAL_ERROR "Initial native Windows support requires MSVC or clang-cl")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
 message(FATAL_ERROR "The legacy Win32 NSPR backend uses x86 CONTEXT registers. Configure with -A Win32; native x64 is not ported yet.")
endif()
set(NETSCAPE_GENERATED "${PROJECT_BINARY_DIR}/generated")
add_library(netscape_platform INTERFACE)
add_dependencies(netscape_platform netscape_nspr_headers)
target_compile_definitions(netscape_platform INTERFACE XP_PC XP_WIN= XP_WIN32= WIN32 _WINDOWS HW_THREADS NSPR_STATIC MOZILLA_CLIENT NSPR AKBAR NO_SSL HAVE_STRERROR _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS
 $<$<CONFIG:Debug>:DEBUG> $<$<NOT:$<CONFIG:Debug>>:NDEBUG>)
if(NETSCAPE_BUILD_WINDOWS_EDITOR)
 target_compile_definitions(netscape_platform INTERFACE EDITOR GOLD)
endif()
target_include_directories(netscape_platform INTERFACE "${NSPR_GENERATED_INCLUDE}" "${NETSCAPE_GENERATED}")
foreach(directory include nspr/include nspr/include/os jpeg lib/libdbm lib/libparse lib/layout lib/libimg lib/libi18n lib/libmisc lib/libmsg lib/libmime lib/xp lib/plugin mocha/include)
 target_include_directories(netscape_platform INTERFACE "${PROJECT_SOURCE_DIR}/${directory}")
endforeach()
foreach(directory cert crypto hash key nav pkcs11 pkcs12 pkcs7 ssl util)
 target_include_directories(netscape_platform INTERFACE "${PROJECT_SOURCE_DIR}/security/lib/${directory}")
endforeach()
file(GLOB headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/nspr/include/*.h")
foreach(header IN LISTS headers)
 get_filename_component(name "${header}" NAME)
 configure_file("${header}" "${NSPR_GENERATED_INCLUDE}/${name}" COPYONLY)
endforeach()
file(GLOB os_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/nspr/include/os/*.h")
foreach(header IN LISTS os_headers)
 get_filename_component(name "${header}" NAME)
 configure_file("${header}" "${NSPR_GENERATED_INCLUDE}/os/${name}" COPYONLY)
endforeach()
file(GLOB mocha_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/mocha/include/*.h")
foreach(header IN LISTS mocha_headers)
 get_filename_component(name "${header}" NAME)
 configure_file("${header}" "${NETSCAPE_GENERATED}/mocha/${name}" COPYONLY)
endforeach()
# Export netlib's headers without its bundled 1994 winsock.h. Modern native
# builds must resolve that name from the installed Windows SDK.
file(GLOB net_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/lib/libnet/*.h")
foreach(header IN LISTS net_headers)
 get_filename_component(name "${header}" NAME)
 if(NOT name STREQUAL "winsock.h")
  configure_file("${header}" "${NETSCAPE_GENERATED}/net/${name}" COPYONLY)
 endif()
endforeach()
target_include_directories(netscape_platform INTERFACE "${NETSCAPE_GENERATED}/net")
target_link_libraries(netscape_platform INTERFACE wsock32 winmm user32 advapi32)
