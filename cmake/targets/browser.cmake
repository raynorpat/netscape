include("${CMAKE_CURRENT_LIST_DIR}/xfe-sources.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/hpane.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/xml.cmake")
netscape_xfe_resources()
target_link_libraries(netscape_hpane PUBLIC ${MOTIF_LIBRARIES})
target_link_libraries(netscape_xml PUBLIC ${MOTIF_LIBRARIES})
set(xfe_generated "${NETSCAPE_GENERATED}/xfe")
set(generator "${PROJECT_SOURCE_DIR}/cmake/modules/generate.py")
foreach(kind license ekit resources)
  set(byproducts)
  if(kind STREQUAL "ekit")
    set(output "${xfe_generated}/e_kit_resources.h")
    set(inputs "${PROJECT_SOURCE_DIR}/cmd/xfe/e_kit.ad")
  elseif(kind STREQUAL "license")
    set(output "${xfe_generated}/LICENSE-export.c")
    file(GLOB inputs CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/l10n/us/xp/LICENSE-*")
  else()
    set(output "${xfe_generated}/RESOURCES-export.c")
    set(byproducts "${xfe_generated}/RESOURCES-export.ad")
    set(inputs "${PROJECT_SOURCE_DIR}/cmd/xfe/resources" "${PROJECT_SOURCE_DIR}/cmd/xfe/strs" "${PROJECT_SOURCE_DIR}/cmd/xfe/make-resources" "${PROJECT_SOURCE_DIR}/cmd/xfe/ad2c")
  endif()
  add_custom_command(OUTPUT "${output}" BYPRODUCTS ${byproducts} COMMAND ${Python3_EXECUTABLE} "${generator}" ${kind} "${PROJECT_SOURCE_DIR}" "${output}"
    DEPENDS "${generator}" "${PROJECT_SOURCE_DIR}/cmd/xfe/versionn.h" ${inputs} VERBATIM)
  list(APPEND generated_sources "${output}")
endforeach()
list(REMOVE_ITEM NETSCAPE_XFE_SOURCES "${PROJECT_SOURCE_DIR}/cmd/xfe/e_kit.c")
configure_file("${PROJECT_SOURCE_DIR}/cmd/xfe/e_kit.c" "${xfe_generated}/e_kit.c" COPYONLY)
add_executable(netscape_mkicons "${PROJECT_SOURCE_DIR}/cmd/xfe/mkicons.c")
target_link_libraries(netscape_mkicons PRIVATE netscape_platform netscape_img netscape_jpeg netscape_xp)
add_dependencies(netscape_mkicons netscape_nspr_headers)
# Preserve the original ordering: B icons follow all other uppercase icons.
file(GLOB icons CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}/cmd/xfe" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/[AC-Z]*.gif")
file(GLOB b_icons CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}/cmd/xfe" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/B*.gif")
file(GLOB animations CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}/cmd/xfe" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/anim/meteors/*.gif" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/anim/mozilla/*.gif" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/anim/compass/*.gif" "${PROJECT_SOURCE_DIR}/cmd/xfe/icons/anim/sgi/*.gif")
set(icon_inputs ${icons} ${b_icons} icons/app.gif ${animations})
set(icon_dependencies)
foreach(icon IN LISTS icon_inputs)
 list(APPEND icon_dependencies "${PROJECT_SOURCE_DIR}/cmd/xfe/${icon}")
endforeach()
string(REPLACE ";" "|" icon_arguments "${icon_inputs}")
add_custom_command(OUTPUT "${xfe_generated}/icondata.c"
 COMMAND ${CMAKE_COMMAND} -DGENERATOR=$<TARGET_FILE:netscape_mkicons> -DOUTPUT=${xfe_generated}/icondata.c "-DARGUMENTS=${icon_arguments}" -P "${PROJECT_SOURCE_DIR}/cmake/modules/RunGenerator.cmake"
 DEPENDS netscape_mkicons "${PROJECT_SOURCE_DIR}/cmake/modules/RunGenerator.cmake" ${icon_dependencies} WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/cmd/xfe" VERBATIM)
add_executable(netscape-export ${NETSCAPE_XFE_SOURCES} "${PROJECT_SOURCE_DIR}/cmd/xfe/config.c" "${xfe_generated}/e_kit.c" "${xfe_generated}/icondata.c" ${generated_sources} ${NETSCAPE_RESOURCE_SOURCES})
target_link_libraries(netscape-export PRIVATE netscape_platform)
add_dependencies(netscape-export netscape_nspr_headers netscape_xfe_resources)
file(STRINGS "${PROJECT_SOURCE_DIR}/cmd/xfe/versionn.h" version_line REGEX "^#define VERSION_NUMBER")
string(REGEX REPLACE "^#define VERSION_NUMBER[ \t]+" "" browser_version "${version_line}")
string(TIMESTAMP build_date "%d-%b-%y" UTC)
set_property(SOURCE "${PROJECT_SOURCE_DIR}/cmd/xfe/config.c" APPEND PROPERTY COMPILE_DEFINITIONS "CONFIG=${CMAKE_SYSTEM_PROCESSOR}-unknown-linux" "VERSION=${browser_version}" "DATE=${build_date}")
set(browser_libraries netscape_xml netscape_hpane netscape_xlate netscape_net netscape_lay netscape_i18n netscape_img netscape_jpeg netscape_misc netscape_parse netscape_msg netscape_mime netscape_plugin netscape_dbm)
if(NETSCAPE_ENABLE_JAVA)
 list(APPEND browser_libraries netscape_java ${NETSCAPE_JAVA_LIBRARIES})
endif()
if(NETSCAPE_ENABLE_MOCHA)
 list(APPEND browser_libraries netscape_libmocha netscape_mocha netscape_misc)
endif()
if(NETSCAPE_ENABLE_SECURITY)
 list(APPEND browser_libraries netscape_secnav netscape_secmod netscape_pkcs12 netscape_hash netscape_ssl netscape_pkcs7 netscape_cert netscape_key netscape_crypto netscape_secutil netscape_jar)
else()
 list(APPEND browser_libraries netscape_hash)
endif()
list(APPEND browser_libraries netscape_xp netscape_nspr)
# The original link repeats archives. GNU rescan groups resolve their cycles.
target_link_libraries(netscape-export PRIVATE "-Wl,--start-group" ${browser_libraries} "-Wl,--end-group" ${MOTIF_LIBRARIES} ${X11_LIBRARIES} ${X11_Xt_LIB} ${X11_Xmu_LIB} ${X11_Xpm_LIB} ${X11_Xext_LIB} ${X11_SM_LIB} ${X11_ICE_LIB} ${CMAKE_DL_LIBS} m)
