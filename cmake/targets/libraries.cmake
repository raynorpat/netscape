# Legacy archives; library order for the browser is specified in browser.cmake.
foreach(component nspr lay i18n img misc parse msg net plugin xlate xp mime jar secnav secmod pkcs12 hash ssl pkcs7 cert key crypto secutil)
  include("${CMAKE_CURRENT_LIST_DIR}/${component}.cmake")
endforeach()
target_compile_definitions(netscape_nspr PRIVATE _NSPR)
target_compile_definitions(netscape_i18n PRIVATE HAS_FE)
target_compile_definitions(netscape_misc PRIVATE HAS_FE)
target_include_directories(netscape_i18n PRIVATE "${PROJECT_SOURCE_DIR}/lib/libi18n/unicode/ufrmtbl" "${PROJECT_SOURCE_DIR}/lib/libi18n/unicode/utotbl")
target_link_libraries(netscape_img PUBLIC netscape_jpeg)
target_link_libraries(netscape_nspr PUBLIC ${CMAKE_DL_LIBS} m)
target_link_libraries(netscape_dbm PRIVATE netscape_platform)
if(NETSCAPE_ENABLE_MOCHA)
  include("${CMAKE_CURRENT_LIST_DIR}/mocha.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/libmocha.cmake")
  target_sources(netscape_lay PRIVATE "${PROJECT_SOURCE_DIR}/lib/layout/laymocha.c" "${PROJECT_SOURCE_DIR}/lib/layout/layscrip.c")
  target_link_libraries(netscape_mocha PUBLIC netscape_nspr m)
endif()
if(NETSCAPE_BUILD_SUN_JAVA AND NOT NETSCAPE_ENABLE_JAVA)
 include("${CMAKE_CURRENT_LIST_DIR}/sun-java.cmake")
endif()
if(NETSCAPE_ENABLE_JAVA)
  include(NetscapeJava)
  include("${CMAKE_CURRENT_LIST_DIR}/java.cmake")
  if(TARGET netscape_sun_java_config)
   target_link_libraries(netscape_java PRIVATE netscape_sun_java_config)
   target_link_libraries(netscape_platform INTERFACE netscape_sun_java_headers)
  endif()
  target_sources(netscape_lay PRIVATE "${PROJECT_SOURCE_DIR}/lib/layout/layjava.c")
  target_sources(netscape_plugin PRIVATE "${PROJECT_SOURCE_DIR}/lib/plugin/npjava.c")
endif()
find_package(ZLIB REQUIRED)
target_link_libraries(netscape_jar PUBLIC ZLIB::ZLIB)
if(NETSCAPE_BUILD_MOCHA_SHELL)
 if(NOT NETSCAPE_ENABLE_MOCHA)
  message(FATAL_ERROR "The Mocha shell requires NETSCAPE_ENABLE_MOCHA=ON")
 endif()
 target_compile_definitions(netscape_mocha PUBLIC MOCHAFILE)
 target_link_libraries(netscape_libmocha PRIVATE netscape_mocha)
 add_executable(netscape_mocha_shell "${PROJECT_SOURCE_DIR}/mocha/tests/mo_shell.c")
 target_link_libraries(netscape_mocha_shell PRIVATE netscape_platform netscape_mocha)
endif()
include(NetscapeGenerated)

if(NOT NETSCAPE_ENABLE_SECURITY)
 foreach(component jar secnav secmod pkcs12 ssl pkcs7 cert key crypto secutil)
  set_target_properties(netscape_${component} PROPERTIES EXCLUDE_FROM_ALL TRUE)
 endforeach()
endif()

include(NetscapeResources)
