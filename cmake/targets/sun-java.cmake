include_guard(GLOBAL)
set(SUN_JAVA_STAGE "${PROJECT_BINARY_DIR}/generated/sun-java")
set(NETSCAPE_JAVA_CLASSPATH "" CACHE STRING "Classpath for explicit legacy javah regeneration; defaults to the shipped runtime archive")
set(NETSCAPE_JAVA_BOOTSTRAP_COMMAND "" CACHE STRING "Semicolon-separated vintage javac command for rebuilding Java classes")
option(NETSCAPE_REBUILD_JAVA_CLASSES "Rebuild the Java class archive using a configured vintage compiler" OFF)
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
 message(WARNING "The sun-java source runtime has not been ported or verified for x64. Use a compatible 32-bit toolchain for the vintage JVM.")
endif()
# Stage native source and the checked-in generated headers/stubs together.
# Their quoted relative includes must not select stale files in the checkout.
set(java_directories include md-include runtime md java javah javap awt/x mmedia/stub netscape/applet netscape/javascript netscape/net classsrc)
foreach(directory IN LISTS java_directories)
 file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/sun-java/${directory}/*.h" "${PROJECT_SOURCE_DIR}/sun-java/${directory}/*.c" "${PROJECT_SOURCE_DIR}/sun-java/${directory}/*.java")
 foreach(input IN LISTS inputs)
  if(input MATCHES "\\.OBJ/" OR input MATCHES "/include/opcodes.h$" OR input MATCHES "/RuntimeConstants.java$")
   continue()
  endif()
  file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}/sun-java" "${input}")
  configure_file("${input}" "${SUN_JAVA_STAGE}/${relative}" COPYONLY)
 endforeach()
endforeach()
add_library(netscape_sun_java_headers INTERFACE)
target_include_directories(netscape_sun_java_headers BEFORE INTERFACE "${SUN_JAVA_STAGE}/include" "${SUN_JAVA_STAGE}/include/_gen" "${SUN_JAVA_STAGE}/md-include" "${SUN_JAVA_STAGE}/netscape/applet/_gen" "${SUN_JAVA_STAGE}/netscape/javascript/_gen")
add_dependencies(netscape_sun_java_headers netscape_java_opcodes)
add_library(netscape_sun_java_config INTERFACE)
target_link_libraries(netscape_sun_java_config INTERFACE netscape_platform netscape_sun_java_headers)
target_compile_definitions(netscape_sun_java_config INTERFACE NETSCAPE COMPILER JAVA $<$<CONFIG:Debug>:TRACING> $<$<NOT:$<CONFIG:Debug>>:TRIMMED>)
target_include_directories(netscape_sun_java_config BEFORE INTERFACE "${SUN_JAVA_STAGE}/include" "${SUN_JAVA_STAGE}/include/_gen" "${SUN_JAVA_STAGE}/md-include" "${SUN_JAVA_STAGE}/runtime" "${SUN_JAVA_STAGE}/netscape/applet/_gen" "${SUN_JAVA_STAGE}/netscape/javascript/_gen")
set(java_generator "${PROJECT_SOURCE_DIR}/cmake/modules/sun_java_generate.py")
set(opcodes)
foreach(name opcodes.h opcodes.init opcodes.length opcodes.in_out)
 list(APPEND opcodes "${SUN_JAVA_STAGE}/include/${name}")
endforeach()
add_custom_command(OUTPUT ${opcodes}
 COMMAND ${Python3_EXECUTABLE} "${java_generator}" opcodes "${PROJECT_SOURCE_DIR}/sun-java/include/opcodes.list" "${SUN_JAVA_STAGE}/include"
 DEPENDS "${java_generator}" "${PROJECT_SOURCE_DIR}/sun-java/include/opcodes.list" VERBATIM)
add_custom_target(netscape_java_opcodes DEPENDS ${opcodes})
function(sun_java_configure target)
 target_link_libraries(${target} PRIVATE netscape_sun_java_config)
 set_target_properties(${target} PROPERTIES C_STANDARD 90 C_EXTENSIONS ON)
 add_dependencies(${target} netscape_nspr_headers netscape_java_opcodes)
endfunction()
function(sun_java_archive target directory output prefix)
 set(sources)
 foreach(source IN LISTS ARGN)
  list(APPEND sources "${SUN_JAVA_STAGE}/${directory}/${source}")
 endforeach()
 add_library(${target} STATIC ${sources})
 sun_java_configure(${target})
 target_include_directories(${target} PRIVATE "${SUN_JAVA_STAGE}/${directory}" "${SUN_JAVA_STAGE}/${directory}/_gen")
 if(prefix STREQUAL "NONE")
  set(prefix "")
 endif()
 set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output}" PREFIX "${prefix}")
endfunction()
function(sun_java_program target output)
 add_executable(${target} ${ARGN})
 sun_java_configure(${target})
 set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output}")
endfunction()
foreach(component javart sunmd javai awt mmedia nsa njs nsn jri javah javap)
 include("${CMAKE_CURRENT_LIST_DIR}/sun-java/${component}.cmake")
endforeach()
# Linux's multimedia implementation is the original no-audio stub.
target_link_libraries(netscape_java_awt PUBLIC ${MOTIF_LIBRARIES} ${X11_LIBRARIES} ${X11_Xt_LIB} netscape_jpeg)
target_include_directories(netscape_java_awt PRIVATE "${PROJECT_SOURCE_DIR}/lib/libjava")
target_link_libraries(netscape_java_javart PUBLIC netscape_jpeg netscape_nspr)
target_link_libraries(netscape_java_sunmd PUBLIC netscape_nspr ${CMAKE_DL_LIBS} m)
file(STRINGS "${PROJECT_SOURCE_DIR}/cmd/xfe/versionn.h" version_line REGEX "^#define VERSION_NUMBER")
string(REGEX REPLACE "^#define VERSION_NUMBER[ \t]+" "" java_version "${version_line}")
target_compile_definitions(netscape_java_sunmd PRIVATE ZIP_NAME="java_${java_version}")
sun_java_program(netscape_java_vm java "${SUN_JAVA_STAGE}/java/java_stub.c" "${SUN_JAVA_STAGE}/java/javai.c")
target_link_libraries(netscape_java_vm PRIVATE "-Wl,--start-group" netscape_java_javart netscape_java_sunmd netscape_jpeg netscape_nspr "-Wl,--end-group" m ${CMAKE_DL_LIBS})
sun_java_program(netscape_java_genconst genconst "${SUN_JAVA_STAGE}/classsrc/genconst.c")
add_custom_command(OUTPUT "${SUN_JAVA_STAGE}/classsrc/sun/tools/java/RuntimeConstants.java"
 COMMAND ${Python3_EXECUTABLE} "${java_generator}" constants $<TARGET_FILE:netscape_java_genconst> "${SUN_JAVA_STAGE}/classsrc/sun/tools/java/RuntimeConstants.java"
 DEPENDS netscape_java_genconst "${java_generator}" VERBATIM)
add_custom_target(netscape_java_constants DEPENDS "${SUN_JAVA_STAGE}/classsrc/sun/tools/java/RuntimeConstants.java")
set(java_class_archive "${SUN_JAVA_STAGE}/classes/java_${java_version}")
file(GLOB_RECURSE java_class_sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/sun-java/classsrc/*.java")
if(NETSCAPE_REBUILD_JAVA_CLASSES)
 if(NOT NETSCAPE_JAVA_BOOTSTRAP_COMMAND)
  message(FATAL_ERROR "NETSCAPE_REBUILD_JAVA_CLASSES requires NETSCAPE_JAVA_BOOTSTRAP_COMMAND (a compatible vintage compiler)")
 endif()
 add_custom_command(OUTPUT "${java_class_archive}" "${SUN_JAVA_STAGE}/classes/javac.zip"
  COMMAND ${Python3_EXECUTABLE} "${java_generator}" classes "${SUN_JAVA_STAGE}/classsrc" "${java_class_archive}" "${PROJECT_SOURCE_DIR}/cmake/modules/sun-java-packages.json" ${NETSCAPE_JAVA_BOOTSTRAP_COMMAND}
  DEPENDS netscape_java_constants "${java_generator}" "${PROJECT_SOURCE_DIR}/cmake/modules/sun-java-packages.json" ${java_class_sources} VERBATIM)
else()
 configure_file("${PROJECT_SOURCE_DIR}/sun-java/classsrc/java_${java_version}.x" "${java_class_archive}" COPYONLY)
endif()
add_custom_target(netscape_java_classes DEPENDS "${java_class_archive}")
if(NOT NETSCAPE_JAVA_CLASSPATH)
 set(NETSCAPE_JAVA_CLASSPATH "${java_class_archive}")
endif()
# Regeneration is explicit: normal builds use the checked-in native interfaces.
# javah's reduced runtime is independent of the full runtime/stubs, avoiding a bootstrap cycle.
add_custom_target(netscape_java_regenerate_natives
 COMMAND ${Python3_EXECUTABLE} "${java_generator}" natives $<TARGET_FILE:netscape_javah> "${SUN_JAVA_STAGE}" "${PROJECT_SOURCE_DIR}/cmake/modules/sun-java-natives.json" "${NETSCAPE_JAVA_CLASSPATH}"
 DEPENDS netscape_javah netscape_java_classes VERBATIM)
set(NETSCAPE_JAVA_LIBRARIES netscape_java_nsn netscape_java_nsa netscape_java_javai netscape_java_javart netscape_java_sunmd netscape_java_awt netscape_java_mmedia)
# The old javah Makefile leaves libjri out of its default targets; its thunk
# interface does not match the current checked-in JRI headers.
set_target_properties(netscape_java_jri PROPERTIES EXCLUDE_FROM_ALL TRUE)
if(NETSCAPE_ENABLE_MOCHA)
 list(APPEND NETSCAPE_JAVA_LIBRARIES netscape_java_njs)
else()
 set_target_properties(netscape_java_njs PROPERTIES EXCLUDE_FROM_ALL TRUE)
endif()
add_custom_target(netscape_sun_java DEPENDS ${NETSCAPE_JAVA_LIBRARIES} netscape_java_vm netscape_javah netscape_javap netscape_java_constants netscape_java_classes netscape_javac netscape_javadoc)
install(TARGETS netscape_java_vm netscape_javah netscape_javap RUNTIME DESTINATION bin)
install(FILES "${java_class_archive}" DESTINATION lib/netscape)

foreach(tool javac javadoc)
 set(launcher "${PROJECT_BINARY_DIR}/bin/${tool}")
 add_custom_command(OUTPUT "${launcher}"
  COMMAND ${Python3_EXECUTABLE} "${java_generator}" launcher $<TARGET_FILE:netscape_java_vm> "${SUN_JAVA_STAGE}/classes/javac.zip" ${tool} "${launcher}"
  DEPENDS "${java_generator}" VERBATIM)
 add_custom_target(netscape_${tool} DEPENDS "${launcher}" netscape_java_vm netscape_java_classes)
endforeach()
# Explicit static-AWT launcher variant from sun-java/java/Makefile.
sun_java_program(netscape_java_vm_static java_s "${SUN_JAVA_STAGE}/java/java_stub.c" "${SUN_JAVA_STAGE}/java/javai.c")
set_target_properties(netscape_java_vm_static PROPERTIES EXCLUDE_FROM_ALL TRUE)
target_compile_definitions(netscape_java_vm_static PRIVATE STATIC_JAVA)
target_link_libraries(netscape_java_vm_static PRIVATE "-Wl,--start-group" netscape_java_javart netscape_java_sunmd netscape_java_awt netscape_java_mmedia netscape_jpeg netscape_nspr "-Wl,--end-group" ${MOTIF_LIBRARIES} ${X11_LIBRARIES} ${X11_Xt_LIB} m ${CMAKE_DL_LIBS})
