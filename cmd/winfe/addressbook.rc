#include "addressbook-resource.h"
IDR_ADDRESSBOOK MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&Save", IDC_AB_SAVE
  MENUITEM "&Retry Load", IDC_AB_RETRY_LOAD
  MENUITEM SEPARATOR
  MENUITEM "&Close", IDC_AB_CLOSE
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Undo", IDC_AB_UNDO
  MENUITEM "&Redo", IDC_AB_REDO
  MENUITEM SEPARATOR
  MENUITEM "Cu&t", IDC_AB_CUT
  MENUITEM "&Copy", IDC_AB_COPY
  MENUITEM "&Paste", IDC_AB_PASTE
  MENUITEM "&Delete\tDel", IDC_AB_DELETE
  MENUITEM "Select &All", IDC_AB_SELECT_ALL
 END
 POPUP "&Item"
 BEGIN
  MENUITEM "Add &User", IDC_AB_ADD_USER
  MENUITEM "Add &List", IDC_AB_ADD_LIST
  MENUITEM "&Properties...", IDC_AB_PROPERTIES
  MENUITEM SEPARATOR
  MENUITEM "&Compose Message", IDC_AB_COMPOSE
 END
END
IDD_ADDRESS_PROPERTIES DIALOGEX 0,0,280,238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Address Book Properties"
FONT 8,"MS Sans Serif"
BEGIN
 LTEXT "&Name:",-1,7,10,55,10
 EDITTEXT IDC_AB_NAME,65,7,208,14,ES_AUTOHSCROLL
 LTEXT "&Email Address:",-1,7,32,56,10
 EDITTEXT IDC_AB_EMAIL,65,29,208,14,ES_AUTOHSCROLL
 LTEXT "&Nickname:",-1,7,54,55,10
 EDITTEXT IDC_AB_NICKNAME,65,51,208,14,ES_AUTOHSCROLL
 LTEXT "&Description:",-1,7,76,55,10
 EDITTEXT IDC_AB_DESCRIPTION,65,73,208,30,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
 LTEXT "List &members:",-1,7,114,75,10
 EDITTEXT IDC_AB_MEMBERS,7,127,266,77,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
 DEFPUSHBUTTON "OK",IDOK,164,216,50,14
 PUSHBUTTON "Cancel",IDCANCEL,223,216,50,14
END

IDD_ADDRESS_PICKER DIALOGEX 0,0,184,198
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Addresses"
FONT 8,"MS Sans Serif"
BEGIN
 LISTBOX IDC_AB_PICK_LIST,7,7,170,142,LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "&To:",IDC_AB_TO,12,158,50,14
 PUSHBUTTON "&Cc:",IDC_AB_CC,68,158,50,14
 PUSHBUTTON "&Bcc:",IDC_AB_BCC,124,158,50,14
 DEFPUSHBUTTON "OK",IDOK,68,180,50,14
END
