#include <windows.h>
#include "resource.h"
#define RESOURCE_STR
#include "allxpstr.rc"
IDR_MAIN ICON "res/netscape.ico"
IDR_MAIN MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&New Browser Window\tCtrl+N", ID_BROWSER_NEW
  MENUITEM "&Open...\tCtrl+O", ID_BROWSER_OPEN
  MENUITEM "Open &Location...\tCtrl+L", ID_FOCUS_LOCATION
  MENUITEM "&Save As...\tCtrl+S", ID_BROWSER_SAVE
  MENUITEM "&Print...", ID_BROWSER_PRINT, GRAYED
  MENUITEM SEPARATOR
  MENUITEM "&Close", 0xE141
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Undo\tCtrl+Z", 0xE12B
  MENUITEM SEPARATOR
  MENUITEM "Cu&t\tCtrl+X", 0xE123
  MENUITEM "&Copy\tCtrl+C", 0xE122
  MENUITEM "&Paste\tCtrl+V", 0xE125
  MENUITEM "Select &All\tCtrl+A", 0xE12A
  MENUITEM SEPARATOR
  MENUITEM "&Find...\tCtrl+F", ID_BROWSER_FIND
 END
 POPUP "&View"
 BEGIN
  MENUITEM "&Toolbar", ID_VIEW_TOOLBAR, CHECKED
  MENUITEM "&Location", ID_VIEW_LOCATION, CHECKED
  MENUITEM "&Directory Buttons", ID_VIEW_DIRECTORY, CHECKED
  MENUITEM "&Status Bar", ID_VIEW_STATUS, CHECKED
  MENUITEM SEPARATOR
  MENUITEM "&Reload\tF5", ID_NAV_RELOAD
  MENUITEM "Load &Images", ID_BROWSER_IMAGES, GRAYED
 END
 POPUP "&Go"
 BEGIN
  MENUITEM "&Back\tAlt+Left", ID_NAV_BACK
  MENUITEM "&Forward\tAlt+Right", ID_NAV_FORWARD
  MENUITEM "&Home", ID_NAV_HOME
  MENUITEM "&Stop\tEsc", ID_NAV_STOP
  MENUITEM SEPARATOR
  MENUITEM "&History...", ID_BROWSER_HISTORY
 END
 POPUP "&Bookmarks"
 BEGIN
  MENUITEM "&Add Bookmark\tCtrl+D", ID_BOOKMARKS_ADD
  MENUITEM "&Go to Bookmarks...", ID_BOOKMARKS_SHOW
 END
 POPUP "&Options"
 BEGIN
  MENUITEM "Set Current Page as &Home", ID_BROWSER_SET_HOME
  MENUITEM "&Mail and News Preferences...", ID_MAIL_SETTINGS
 END
 POPUP "&Directory"
 BEGIN
  MENUITEM "What's &New?", ID_DIRECTORY_FIRST
  MENUITEM "What's &Cool?", ID_DIRECTORY_FIRST + 1
  MENUITEM "&Destinations", ID_DIRECTORY_FIRST + 2
  MENUITEM "Net &Search", ID_DIRECTORY_FIRST + 3
  MENUITEM "&People", ID_DIRECTORY_FIRST + 4
  MENUITEM "&Software", ID_DIRECTORY_LAST
 END
 POPUP "&Window"
 BEGIN
  MENUITEM "Netscape &Navigator", ID_BROWSER_NEW
  MENUITEM "Netscape &Mail", ID_CLIENT_MAIL
  MENUITEM "Netscape &News", ID_CLIENT_NEWS
  MENUITEM SEPARATOR
  MENUITEM "&Compose Message", ID_CLIENT_COMPOSE
  MENUITEM "&Post News", ID_CLIENT_POST
  MENUITEM "&Bookmarks", ID_BOOKMARKS_SHOW
  POPUP "&Messages"
  BEGIN
   MENUITEM "&Reply to Sender", ID_MESSAGE_REPLY
   MENUITEM "Reply to &All", ID_MESSAGE_REPLY_ALL
   MENUITEM "&Forward", ID_MESSAGE_FORWARD
   MENUITEM "&Get New Mail", ID_MESSAGE_GET
   MENUITEM "&Send Queued Messages", ID_MESSAGE_SEND_QUEUED
   MENUITEM "&Delete Message", ID_MESSAGE_DELETE
   MENUITEM "Mark &Read", ID_MESSAGE_READ
   MENUITEM "Show All Messages", ID_MESSAGE_SHOW_ALL
   MENUITEM "Show Unread Messages", ID_MESSAGE_SHOW_UNREAD
  END
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "&About Netscape", ID_BROWSER_ABOUT
 END
END
IDD_MAIL_SETTINGS DIALOGEX 0, 0, 310, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mail and news account settings"
FONT 8, "MS Sans Serif"
BEGIN
 LTEXT "Email address", -1, 8, 10, 80, 12
 EDITTEXT ID_SETTING_EMAIL, 92, 8, 208, 14, ES_AUTOHSCROLL
 LTEXT "Your name", -1, 8, 32, 80, 12
 EDITTEXT ID_SETTING_NAME, 92, 30, 208, 14, ES_AUTOHSCROLL
 LTEXT "Organization", -1, 8, 54, 80, 12
 EDITTEXT ID_SETTING_ORGANIZATION, 92, 52, 208, 14, ES_AUTOHSCROLL
 LTEXT "SMTP server", -1, 8, 76, 80, 12
 EDITTEXT ID_SETTING_SMTP, 92, 74, 208, 14, ES_AUTOHSCROLL
 LTEXT "POP server", -1, 8, 98, 80, 12
 EDITTEXT ID_SETTING_POP, 92, 96, 208, 14, ES_AUTOHSCROLL
 LTEXT "News server", -1, 8, 120, 80, 12
 EDITTEXT ID_SETTING_NEWS, 92, 118, 208, 14, ES_AUTOHSCROLL
 DEFPUSHBUTTON "Save", IDOK, 188, 148, 52, 14
 PUSHBUTTON "Cancel", IDCANCEL, 248, 148, 52, 14
END
IDD_NATIVE_PROMPT DIALOGEX 0, 0, 300, 100
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Netscape"
FONT 8, "MS Sans Serif"
BEGIN
 LTEXT "", ID_PROMPT_LABEL, 8, 8, 284, 34
 EDITTEXT ID_PROMPT_VALUE, 8, 45, 284, 15, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 180, 78, 52, 14
 PUSHBUTTON "Cancel", IDCANCEL, 240, 78, 52, 14
END
IDR_MAIN ACCELERATORS
BEGIN
 "L", ID_FOCUS_LOCATION, VIRTKEY, CONTROL
 "D", ID_FOCUS_LOCATION, VIRTKEY, ALT
 "N", ID_BROWSER_NEW, VIRTKEY, CONTROL
 "F", ID_BROWSER_FIND, VIRTKEY, CONTROL
 "C", 0xE122, VIRTKEY, CONTROL
 "X", 0xE123, VIRTKEY, CONTROL
 "V", 0xE125, VIRTKEY, CONTROL
 "A", 0xE12A, VIRTKEY, CONTROL
 "Z", 0xE12B, VIRTKEY, CONTROL
 "O", ID_BROWSER_OPEN, VIRTKEY, CONTROL
 "S", ID_BROWSER_SAVE, VIRTKEY, CONTROL
 "D", ID_BOOKMARKS_ADD, VIRTKEY, CONTROL
 VK_F5, ID_NAV_RELOAD, VIRTKEY
 VK_ESCAPE, ID_NAV_STOP, VIRTKEY
 VK_LEFT, ID_NAV_BACK, VIRTKEY, ALT
 VK_RIGHT, ID_NAV_FORWARD, VIRTKEY, ALT
END
1 VERSIONINFO
FILEVERSION 3,0,2,0
PRODUCTVERSION 3,0,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904e4"
  BEGIN
   VALUE "FileDescription", "Netscape 3.02 Windows frontend port\0"
   VALUE "FileVersion", "3.02\0"
   VALUE "ProductName", "Netscape legacy Windows port\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1252
 END
END

