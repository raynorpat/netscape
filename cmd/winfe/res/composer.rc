#include "../composer_resource.h"
#include "../resource.h"
#include "../menu_resource.h"

IDR_COMPOSER_MENU MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&Send Now\tCtrl+Enter", IDC_COMPOSE_SEND
  MENUITEM SEPARATOR
  MENUITEM "Attach &File...", IDC_COMPOSE_ATTACH
  MENUITEM "&Include Original Text", IDC_COMPOSE_QUOTE
  MENUITEM "Save &As...\tCtrl+S", ID_COMPOSE_SAVE_AS
  /* Drafts and attachment removal remain supported native extensions. */
  MENUITEM "Save &Draft", IDC_COMPOSE_DRAFT
  MENUITEM "Remove All Attachments", IDC_COMPOSE_REMOVE
  MENUITEM SEPARATOR
  MENUITEM "&Close\tCtrl+W", IDC_COMPOSE_CANCEL
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Undo\tCtrl+Z", IDC_COMPOSE_UNDO
  MENUITEM SEPARATOR
  MENUITEM "Cu&t\tCtrl+X", IDC_COMPOSE_CUT
  MENUITEM "&Copy\tCtrl+C", IDC_COMPOSE_COPY
  MENUITEM "&Paste\tCtrl+V", IDC_COMPOSE_PASTE
  MENUITEM "Paste as &Quotation", ID_COMPOSE_PASTE_QUOTATION
  MENUITEM SEPARATOR
  MENUITEM "Select &All\tCtrl+A", IDC_COMPOSE_SELECT_ALL
 END
 POPUP "&View"
 BEGIN
  MENUITEM "Show &All", IDC_COMPOSE_HEADERS
  MENUITEM SEPARATOR
  MENUITEM "Fr&om", 4150
  MENUITEM "&Reply To ", 4151
  MENUITEM "Mail &To", 4152
  MENUITEM "Mail &Cc", 4153
  MENUITEM "Mail &Bcc", 4154
  MENUITEM "&Newsgroups", 4156
  MENUITEM "&Followups To", 4157
  MENUITEM "&Subject", 4158
  MENUITEM "Attac&hment", ID_COMPOSE_ATTACHMENTS
  MENUITEM SEPARATOR
  MENUITEM "&Wrap Long Lines", ID_COMPOSE_WRAP
 END
 POPUP "&Options"
 BEGIN
  MENUITEM "&Mail and News Preferences...", ID_MAIL_SETTINGS
  MENUITEM SEPARATOR
  MENUITEM "&Immediate Delivery", ID_COMPOSE_IMMEDIATE
  MENUITEM "&Deferred Delivery", ID_COMPOSE_DEFERRED
 END
 POPUP "&Window"
 BEGIN
  MENUITEM "Netscape &Mail", ID_CLIENT_MAIL
  MENUITEM "Netscape &News", ID_CLIENT_NEWS
  MENUITEM "&Address Book", ID_MENU_ADDRESS_BOOK, GRAYED
  MENUITEM "&Bookmarks\tCtrl+B", ID_BOOKMARKS_SHOW
  MENUITEM "&History\tCtrl+H", ID_BROWSER_HISTORY
  MENUITEM SEPARATOR
  MENUITEM "New Window", ID_MENU_WINDOW_ANCHOR, GRAYED
 END
END

IDR_COMPOSER_ACCEL ACCELERATORS
BEGIN
 VK_RETURN, IDC_COMPOSE_SEND, VIRTKEY, CONTROL
 "S", ID_COMPOSE_SAVE_AS, VIRTKEY, CONTROL
 "W", IDC_COMPOSE_CANCEL, VIRTKEY, CONTROL
 VK_F4, IDC_COMPOSE_CANCEL, VIRTKEY, CONTROL
 "Z", IDC_COMPOSE_UNDO, VIRTKEY, CONTROL
 "X", IDC_COMPOSE_CUT, VIRTKEY, CONTROL
 "C", IDC_COMPOSE_COPY, VIRTKEY, CONTROL
 "V", IDC_COMPOSE_PASTE, VIRTKEY, CONTROL
 "A", IDC_COMPOSE_SELECT_ALL, VIRTKEY, CONTROL
 "B", ID_BOOKMARKS_SHOW, VIRTKEY, CONTROL
 "H", ID_BROWSER_HISTORY, VIRTKEY, CONTROL
END
