IDD_EDITOR_PROPERTIES DIALOGEX 0, 0, 300, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 8, "MS Sans Serif"
BEGIN
 LTEXT "", IDC_EDITOR_LABEL1, 8, 11, 88, 12
 EDITTEXT IDC_EDITOR_VALUE1, 98, 8, 192, 14, ES_AUTOHSCROLL
 LTEXT "", IDC_EDITOR_LABEL2, 8, 35, 88, 12
 EDITTEXT IDC_EDITOR_VALUE2, 98, 32, 192, 14, ES_AUTOHSCROLL
 LTEXT "", IDC_EDITOR_LABEL3, 8, 59, 88, 12
 EDITTEXT IDC_EDITOR_VALUE3, 98, 56, 192, 14, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 180, 94, 52, 14
 PUSHBUTTON "Cancel", IDCANCEL, 238, 94, 52, 14
END

IDR_EDITOR_ACCEL ACCELERATORS
BEGIN
 "N", ID_EDITOR_NEW, VIRTKEY, CONTROL
 "O", ID_EDITOR_OPEN, VIRTKEY, CONTROL
 "S", ID_EDITOR_SAVE, VIRTKEY, CONTROL
 "W", 0xE141, VIRTKEY, CONTROL
 "M", ID_CLIENT_COMPOSE, VIRTKEY, CONTROL
 "Z", 0xE12B, VIRTKEY, CONTROL
 "Z", 0xE12C, VIRTKEY, CONTROL, SHIFT
 "X", 0xE123, VIRTKEY, CONTROL
 "C", 0xE122, VIRTKEY, CONTROL
 "V", 0xE125, VIRTKEY, CONTROL
 "A", ID_EDITOR_SELECT_ALL, VIRTKEY, CONTROL
 "B", ID_EDITOR_BOLD, VIRTKEY, CONTROL
 "I", ID_EDITOR_ITALIC, VIRTKEY, CONTROL
 "U", ID_EDITOR_UNDERLINE, VIRTKEY, CONTROL
 "T", ID_EDITOR_FIXED, VIRTKEY, CONTROL
 "K", ID_EDITOR_CLEAR_STYLES, VIRTKEY, CONTROL
 "L", ID_EDITOR_LINK, VIRTKEY, CONTROL
 "F", ID_EDITOR_FIND, VIRTKEY, CONTROL
 "R", ID_EDITOR_RELOAD, VIRTKEY, CONTROL
 VK_F3, ID_EDITOR_FIND_AGAIN, VIRTKEY
END
