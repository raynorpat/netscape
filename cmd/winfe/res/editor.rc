/* Native transcription of English Windows Netscape Navigator Gold 3.02
 * RT_MENU 101; SHA256 14a9f98740851e8caee699c48b9a859c9f68155413dc72a04b4733c5a657f8ed.
 * Labels, accelerators, order and separators are copied from that resource.
 * Numeric IDs retain original Gold commands; named IDs route shared frontend commands.
 * GRAYED marks unavailable facilities in this native port. */
IDR_EDITOR MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "New &Web Browser", ID_BROWSER_NEW // Gold 32770
