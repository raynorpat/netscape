   MENUITEM SEPARATOR
   MENUITEM "Japanese(Auto-detect)", ID_MENU_ENCODING_JAPANESE_AUTO, GRAYED // Gold 33117
   MENUITEM "Japanese(ShiftJIS)", ID_MENU_ENCODING_SHIFTJIS, GRAYED // Gold 33118
   MENUITEM "Japanese(EUC)", ID_MENU_ENCODING_JAPANESE_EUC, GRAYED // Gold 33119
   MENUITEM SEPARATOR
   MENUITEM "Traditional Chinese(Big5)", ID_MENU_ENCODING_BIG5, GRAYED // Gold 33120
   MENUITEM "Traditional Chinese(EUC)", ID_MENU_ENCODING_CHINESE_EUC, GRAYED // Gold 33121
   MENUITEM SEPARATOR
   MENUITEM "Simplified Chinese", ID_MENU_ENCODING_CHINESE_GB, GRAYED // Gold 33122
   MENUITEM SEPARATOR
   MENUITEM "Korean", ID_MENU_ENCODING_KOREAN, GRAYED // Gold 33123
   MENUITEM SEPARATOR
   MENUITEM "Cyrillic(Win1251)", ID_MENU_ENCODING_WIN1251, GRAYED // Gold 34370
   MENUITEM "Cyrillic(ISO8859-5)", ID_MENU_ENCODING_CYRILLIC_ISO, GRAYED // Gold 34371
   MENUITEM SEPARATOR
   MENUITEM "Cyrillic(KOI8-R)", ID_MENU_ENCODING_KOI8R, GRAYED // Gold 34372
   MENUITEM SEPARATOR
   MENUITEM "Greek", ID_MENU_ENCODING_GREEK, GRAYED // Gold 34374
   MENUITEM SEPARATOR
   MENUITEM "Turkish", ID_MENU_ENCODING_TURKISH, GRAYED // Gold 34376
   MENUITEM SEPARATOR
   MENUITEM "Unicode(UTF8)", ID_MENU_ENCODING_UTF8, GRAYED // Gold 34377
   MENUITEM SEPARATOR
   MENUITEM "User Defined", ID_MENU_ENCODING_USER, GRAYED // Gold 33124
   MENUITEM SEPARATOR
   MENUITEM "&Set Default", ID_MENU_ENCODING_DEFAULT, GRAYED // Gold 32839
  END
 END
 POPUP "&Directory"
 BEGIN
  MENUITEM "N&etscape's Home", ID_MENU_DIRECTORY_HOME // Gold 65000
  MENUITEM "What's &New?", ID_DIRECTORY_FIRST // Gold 65001
  MENUITEM "What's &Cool?", ID_DIRECTORY_FIRST + 1 // Gold 65002
  MENUITEM SEPARATOR
  MENUITEM "Customer Sho&wcase", ID_MENU_DIRECTORY_SHOWCASE // Gold 65004
  MENUITEM "Netscape &Destinations", ID_DIRECTORY_FIRST + 2 // Gold 65005
  MENUITEM "Internet &Search", ID_DIRECTORY_FIRST + 3 // Gold 65006
  MENUITEM "&People", ID_DIRECTORY_FIRST + 4 // Gold 65007
  MENUITEM "&About the Internet", ID_MENU_DIRECTORY_INTERNET // Gold 65008
 END
 POPUP "&Window"
 BEGIN
  MENUITEM "New Window", ID_MENU_WINDOW_ANCHOR, GRAYED // Gold 34003
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "&About Netscape...", ID_BROWSER_ABOUT // Gold 65199
  MENUITEM "About &Plug-ins", ID_MENU_HELP_PLUGINS // Gold 65018
  MENUITEM "Registration &Information", ID_MENU_HELP_REGISTRATION // Gold 65010
  MENUITEM "Sof&tware", ID_MENU_HELP_SOFTWARE // Gold 65019
  MENUITEM "&Web Page Starter", ID_EDITOR_STARTER, GRAYED // Gold 65020
  MENUITEM SEPARATOR
  MENUITEM "&Handbook", ID_MENU_HELP_HANDBOOK // Gold 65011
  MENUITEM "&Release Notes", ID_MENU_HELP_RELEASE_NOTES // Gold 65012
  MENUITEM "&Frequently Asked Questions", ID_MENU_HELP_FAQ // Gold 65013
  MENUITEM "&On Security", ID_MENU_HELP_SECURITY // Gold 65014
  MENUITEM SEPARATOR
  MENUITEM "How to &Give Feedback", ID_MENU_HELP_FEEDBACK // Gold 65015
  MENUITEM "How to Get &Support", ID_MENU_HELP_SUPPORT // Gold 65016
  MENUITEM "How to &Create Web Services", ID_MENU_HELP_WEB_SERVICES // Gold 65017
 END
END
