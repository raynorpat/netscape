/* Native transcription of English Windows Netscape Navigator Gold 3.02
 * RT_MENU 2; SHA256 097ced5f32c670507c8c640128820abd37b25e35d562c5ceb82ce5f0f9cb11d5.
 * Labels, accelerators, order and separators are copied from that resource.
 * Numeric IDs retain original Gold commands; named IDs route shared frontend commands.
 * GRAYED marks unavailable facilities in this native port. */
IDR_MAIN MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "New &Web Browser\tCtrl+N", ID_BROWSER_NEW // Gold 32770
  POPUP "&New Document"
  BEGIN
   MENUITEM "&Blank", ID_EDITOR_NEW // Gold 42279
   MENUITEM "From &Template", ID_EDITOR_TEMPLATE, GRAYED // Gold 34401
   MENUITEM "From &Wizard...", ID_EDITOR_WIZARD, GRAYED // Gold 65021
  END
  MENUITEM SEPARATOR
  MENUITEM "&Edit Document", ID_EDITOR_EDIT_DOCUMENT // Gold 42003
  MENUITEM SEPARATOR
  MENUITEM "New &Mail Message\tCtrl+M", ID_CLIENT_COMPOSE // Gold 32879
  MENUITEM "Ma&il Document...", ID_MENU_MAIL_DOCUMENT // Gold 32810
  MENUITEM SEPARATOR
  MENUITEM "Open &Location...\tCtrl+L", ID_FOCUS_LOCATION // Gold 32769
  MENUITEM "Open &File in Browser...\tCtrl+O", ID_BROWSER_OPEN // Gold 57601
  MENUITEM "Open File in E&ditor...", ID_EDITOR_OPEN // Gold 42151
  MENUITEM "&Save As...\tCtrl+S", ID_BROWSER_SAVE // Gold 32771
  MENUITEM "&Upload File...", ID_MENU_UPLOAD_FILE, GRAYED // Gold 34366
  MENUITEM SEPARATOR
  MENUITEM "Pa&ge Setup...", ID_MENU_PAGE_SETUP, GRAYED // Gold 57605
  MENUITEM "&Print...", ID_BROWSER_PRINT, GRAYED // Gold 57607
  MENUITEM "Print Pre&view", ID_MENU_PRINT_PREVIEW, GRAYED // Gold 57609
  MENUITEM SEPARATOR
  MENUITEM "&Close\tCtrl+W", 0xE141 // Gold 57602
  MENUITEM "E&xit", ID_MENU_EXIT // Gold 57665
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Undo\tCtrl+Z", 0xE12B // Gold 57643
  MENUITEM SEPARATOR
  MENUITEM "Cu&t\tCtrl+X", 0xE123 // Gold 57635
  MENUITEM "&Copy\tCtrl+C", 0xE122 // Gold 57634
  MENUITEM "&Paste\tCtrl+V", 0xE125 // Gold 57637
  MENUITEM SEPARATOR
  MENUITEM "&Select All\tCtrl+A", 0xE12A // Gold 57642
  MENUITEM SEPARATOR
  MENUITEM "&Find...\tCtrl+F", ID_BROWSER_FIND // Gold 32819
  MENUITEM "Find A&gain\tF3", ID_MENU_FIND_AGAIN // Gold 32880
 END
 POPUP "&View"
 BEGIN
  MENUITEM "&Reload\tCtrl+R", ID_NAV_RELOAD // Gold 32782
  MENUITEM "Reload &Frame", ID_MENU_RELOAD_FRAME // Gold 32881
  MENUITEM "Load &Images\tCtrl+I", ID_BROWSER_IMAGES // Gold 32804
  MENUITEM "Re&fresh", ID_MENU_REFRESH // Gold 32783
  MENUITEM SEPARATOR
  MENUITEM "Document &Source", ID_MENU_DOCUMENT_SOURCE // Gold 32789
  MENUITEM "Document I&nfo", ID_MENU_DOCUMENT_INFO // Gold 32846
  MENUITEM SEPARATOR
  MENUITEM "Frame Source", ID_MENU_FRAME_SOURCE // Gold 34404
  MENUITEM "Frame Info", ID_MENU_FRAME_INFO // Gold 34405
 END
 POPUP "&Go"
 BEGIN
  MENUITEM "&Back\tAlt+<-", ID_NAV_BACK // Gold 32780
  MENUITEM "&Forward\tAlt+->", ID_NAV_FORWARD // Gold 32781
  MENUITEM "&Home", ID_NAV_HOME // Gold 32807
  MENUITEM "&Stop Loading\t<Esc>", ID_NAV_STOP // Gold 32795
  MENUITEM SEPARATOR
  MENUITEM "&Default Publish Location", ID_EDITOR_PUBLISH_LOCATION, GRAYED // Gold 34402
  MENUITEM SEPARATOR
 END
 POPUP "&Bookmarks"
 BEGIN
  MENUITEM "&Add Bookmark\tCtrl+D", ID_BOOKMARKS_ADD // Gold 32811
  MENUITEM "&Go to Bookmarks...\tCtrl+B", ID_BOOKMARKS_SHOW // Gold 32812
  MENUITEM SEPARATOR
 END
 POPUP "&Options"
 BEGIN
  MENUITEM "&General Preferences...", ID_BROWSER_PREFERENCES // Gold 32791
  MENUITEM "&Editor Preferences...", ID_EDITOR_PREFERENCES, GRAYED // Gold 42040
  MENUITEM "&Mail and News Preferences...", ID_MAIL_SETTINGS // Gold 32882
  MENUITEM "&Network Preferences...", ID_MENU_NETWORK_PREFERENCES, GRAYED // Gold 32884
  MENUITEM "&Security Preferences...", ID_MENU_SECURITY_PREFERENCES, GRAYED // Gold 32883
  MENUITEM SEPARATOR
  MENUITEM "Show &Toolbar", ID_VIEW_TOOLBAR // Gold 59392
  MENUITEM "Show &Location", ID_VIEW_LOCATION // Gold 32788
  MENUITEM "Show &Directory Buttons", ID_VIEW_DIRECTORY // Gold 32840
  MENUITEM "Show &Java Console", ID_MENU_JAVA_CONSOLE, GRAYED // Gold 32878
  MENUITEM SEPARATOR
  MENUITEM "&Auto Load Images", ID_MENU_AUTO_IMAGES // Gold 32817
  MENUITEM SEPARATOR
  POPUP "Document &Encoding"
  BEGIN
   MENUITEM "Western(Latin1)", ID_MENU_ENCODING_LATIN1 // Gold 33115
   MENUITEM SEPARATOR
   MENUITEM "Central European(Win1250)", ID_MENU_ENCODING_WIN1250, GRAYED // Gold 34369
