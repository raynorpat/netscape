IDR_MAIL MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "Get New &Mail", ID_MESSAGE_GET
  MENUITEM "&New Message", ID_CLIENT_COMPOSE
  MENUITEM "&Send Queued Messages", ID_MESSAGE_SEND_QUEUED
  MENUITEM SEPARATOR
  MENUITEM "&Print...", ID_BROWSER_PRINT, GRAYED
  MENUITEM SEPARATOR
  MENUITEM "&Close", 0xE141
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Copy\tCtrl+C", 0xE122
  MENUITEM "Select &All\tCtrl+A", 0xE12A
  MENUITEM "&Find...\tCtrl+F", ID_BROWSER_FIND
 END
 POPUP "&View"
 BEGIN
  MENUITEM "&Toolbar", ID_VIEW_TOOLBAR, CHECKED
  MENUITEM "&Status Bar", ID_VIEW_STATUS, CHECKED
  POPUP "Message &Headers"
  BEGIN
   MENUITEM "&Normal", ID_MAIL_HEADERS_SOME
   MENUITEM "&All", ID_MAIL_HEADERS_ALL
  END
  MENUITEM "All &Messages", ID_MESSAGE_SHOW_ALL
  MENUITEM "&Unread Messages", ID_MESSAGE_SHOW_UNREAD
 END
 POPUP "&Message"
 BEGIN
  MENUITEM "&New Message", ID_CLIENT_COMPOSE
  MENUITEM "&Reply to Sender", ID_MESSAGE_REPLY
  MENUITEM "Reply to &All", ID_MESSAGE_REPLY_ALL
  MENUITEM "&Forward", ID_MESSAGE_FORWARD
  MENUITEM SEPARATOR
  MENUITEM "&Delete", ID_MESSAGE_DELETE
  MENUITEM "Mark &Read", ID_MESSAGE_READ
 END
 POPUP "&Go"
 BEGIN
  MENUITEM "&Previous Message", ID_MESSAGE_PREVIOUS
  MENUITEM "&Next Message", ID_MESSAGE_NEXT
 END
 POPUP "&Options"
 BEGIN
  MENUITEM "Mail and News &Preferences...", ID_MAIL_SETTINGS
 END
 POPUP "&Window"
 BEGIN
  MENUITEM "Netscape &Navigator", ID_BROWSER_NEW
  MENUITEM "Netscape &Mail", ID_CLIENT_MAIL
  MENUITEM "Netscape &News", ID_CLIENT_NEWS
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "&About Netscape", ID_BROWSER_ABOUT
 END
END

IDR_MAIL_ACCEL ACCELERATORS
BEGIN
 "N", ID_CLIENT_COMPOSE, VIRTKEY, CONTROL
 "M", ID_CLIENT_COMPOSE, VIRTKEY, CONTROL
 "F", ID_BROWSER_FIND, VIRTKEY, CONTROL
 "C", 0xE122, VIRTKEY, CONTROL
 "A", 0xE12A, VIRTKEY, CONTROL
 "W", 0xE141, VIRTKEY, CONTROL
 VK_DELETE, ID_MESSAGE_DELETE, VIRTKEY
 VK_F5, ID_MESSAGE_GET, VIRTKEY
 VK_ESCAPE, ID_NAV_STOP, VIRTKEY
 VK_LEFT, ID_MESSAGE_PREVIOUS, VIRTKEY, ALT
 VK_RIGHT, ID_MESSAGE_NEXT, VIRTKEY, ALT
END
