IDR_NEWS MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&New News Message\tCtrl+N", ID_CLIENT_POST
  MENUITEM "New &Mail Message\tCtrl+M", ID_NEWS_MAIL_NEW
  MENUITEM "Get &More Messages\tF5", ID_MESSAGE_GET
  MENUITEM SEPARATOR
  MENUITEM "&Print...", ID_BROWSER_PRINT, GRAYED
  MENUITEM SEPARATOR
  MENUITEM "&Close\tCtrl+W", 0xE141
 END
 POPUP "&Edit"
 BEGIN
  MENUITEM "&Copy\tCtrl+C", 0xE122
  MENUITEM "Select &All\tCtrl+A", 0xE12A
  MENUITEM "&Find...\tCtrl+F", ID_BROWSER_FIND
 END
 POPUP "&View"
 BEGIN
  MENUITEM "&Toolbar", ID_VIEW_TOOLBAR, CHECKED
  MENUITEM "&Status Bar", ID_VIEW_STATUS, CHECKED
  MENUITEM "&Threaded Messages", ID_NEWS_THREADED
  POPUP "Message &Headers"
  BEGIN
   MENUITEM "&Normal", ID_MAIL_HEADERS_SOME
   MENUITEM "&All", ID_MAIL_HEADERS_ALL
  END
  MENUITEM "All &Messages", ID_MESSAGE_SHOW_ALL
  MENUITEM "&Unread Messages", ID_MESSAGE_SHOW_UNREAD
 END
 POPUP "&Message"
 BEGIN
  MENUITEM "&New News Message", ID_CLIENT_POST
  MENUITEM "New &Mail Message", ID_NEWS_MAIL_NEW
  MENUITEM "Reply to &Newsgroup", ID_NEWS_REPLY_POST
  MENUITEM "Reply to &Sender by Mail", ID_MESSAGE_REPLY
  MENUITEM "Reply by News and M&ail", ID_NEWS_REPLY_BOTH
  MENUITEM "&Forward by Mail", ID_MESSAGE_FORWARD
  MENUITEM SEPARATOR
  MENUITEM "Mark &Read", ID_MESSAGE_READ
  MENUITEM "Mark &Thread Read", ID_NEWS_MARK_THREAD
  MENUITEM "Mark &Group Read", ID_NEWS_MARK_GROUP
 END
 POPUP "&Go"
 BEGIN
  MENUITEM "&Previous Unread Article\tAlt+Left", ID_MESSAGE_PREVIOUS
  MENUITEM "&Next Unread Article\tAlt+Right", ID_MESSAGE_NEXT
 END
 POPUP "&Options"
 BEGIN
  MENUITEM "&Subscribed Newsgroups", ID_NEWS_SUBSCRIBED
  MENUITEM "&All Newsgroups", ID_NEWS_ALL_GROUPS
  MENUITEM "&Subscribe to Selected Group\tSpace", ID_NEWS_SUBSCRIBE
  MENUITEM SEPARATOR
  MENUITEM "&General Preferences...", ID_BROWSER_PREFERENCES
  MENUITEM "Mail and News &Preferences...", ID_MAIL_SETTINGS
 END
 POPUP "&Window"
 BEGIN
  MENUITEM "Netscape &Navigator", ID_BROWSER_NEW
  MENUITEM "Netscape &Mail", ID_CLIENT_MAIL
  MENUITEM "Netscape &News", ID_CLIENT_NEWS
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "&About Netscape", ID_BROWSER_ABOUT
 END
END

IDR_NEWS_ACCEL ACCELERATORS
BEGIN
 "N", ID_CLIENT_POST, VIRTKEY, CONTROL
 "M", ID_NEWS_MAIL_NEW, VIRTKEY, CONTROL
 "F", ID_BROWSER_FIND, VIRTKEY, CONTROL
 "C", 0xE122, VIRTKEY, CONTROL
 "A", 0xE12A, VIRTKEY, CONTROL
 "W", 0xE141, VIRTKEY, CONTROL
 VK_F5, ID_MESSAGE_GET, VIRTKEY
 VK_ESCAPE, ID_NAV_STOP, VIRTKEY
 VK_LEFT, ID_MESSAGE_PREVIOUS, VIRTKEY, ALT
 VK_RIGHT, ID_MESSAGE_NEXT, VIRTKEY, ALT
END
