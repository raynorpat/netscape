#include <windows.h>
#include "../preferences_resource.h"

IDD_GENERAL_PREFERENCES DIALOGEX 0, 0, 334, 253
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", IDC_PREF_TABS, "SysTabControl32", WS_TABSTOP, 5, 3, 324, 226
    DEFPUSHBUTTON "OK", IDOK, 172, 233, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 227, 233, 50, 14
    PUSHBUTTON "Help", IDC_PREF_HELP, 281, 233, 50, 14
END

IDD_PREFERENCES_PAGE DIALOGEX 0, 0, 310, 207
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Sans Serif"
BEGIN
END
